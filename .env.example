# NVIDIA_API_KEY: Required for NVIDIA NIM AI API calls (DeepSeek V4 Pro).
# Users configure this via the Secrets panel in the AI Studio UI.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Market Data Provider: Biquote (https://biquote.io)
# Direct live MT5 feed for XAUUSD (1m, 5m, 15m, 1h OHLC up to 1000 bars)
# Zero API key, zero signup, zero subscription required.

# MT5 Execution Bridge Configuration (External Windows/VPS MT5 Connector)
# Example: http://your-vps-ip:5001 or https://mt5-bridge.yourdomain.com
MT5_BRIDGE_URL=
# Shared secret / Bearer token authentication for MT5 Bridge API
MT5_API_KEY=
# MT5 Account Number (Optional default for metadata)
MT5_ACCOUNT=
# MT5 Server name (e.g. MetaQuotes-Demo, Exness-Real)
MT5_SERVER=
# MT5 Account Type: DEMO or REAL
MT5_ACCOUNT_TYPE=DEMO

# Server & Runtime Configuration (Render / Local)
PORT=3000
NODE_ENV=production

# Telegram Bot Integration (Notifications only - No trade execution)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase / Firestore Durable Storage Configuration (Optional on Render if firebase-applet-config.json exists)
# Can be provided as an inline JSON string if not using a config file:
# FIREBASE_CONFIG={"projectId":"","apiKey":"","appId":"","authDomain":"","firestoreDatabaseId":""}
FIREBASE_CONFIG=
FIREBASE_DATABASE_ID=

