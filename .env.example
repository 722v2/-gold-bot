# AI Model Provider: OpenRouter (Gemini 2.5 Flash Lite) or NVIDIA NIM
# OPENROUTER_API_KEY: Required for production AI analysis via OpenRouter (google/gemini-2.5-flash-lite)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.5-flash-lite"

# NVIDIA NIM Alternative AI Provider
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="deepseek-ai/deepseek-v4-flash-0731"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Market Data Provider: Biquote (https://biquote.io)
# Direct live MT5 feed for XAUUSD (1m, 5m, 15m, 1h OHLC up to 1000 bars)
# Zero API key, zero signup, zero subscription required.

# MT5 Execution Bridge Configuration (External Windows/VPS MT5 Connector)
# Example: http://your-vps-ip:5001 or https://mt5-bridge.yourdomain.com
MT5_BRIDGE_URL=
# Shared secret / Bearer token authentication for MT5 Bridge API
MT5_API_KEY=
# Additional server-side safety switch. Keep false/unset until real execution is intentionally enabled.
# Real MT5 execution requires BOTH this flag and Settings.autoTradingEnabled=true.
MT5_LIVE_EXECUTION_ENABLED=false
# MT5 Account Number (Optional default for metadata)
MT5_ACCOUNT=
# MT5 Server name (e.g. MetaQuotes-Demo, Exness-Real)
MT5_SERVER=
# MT5 Account Type: DEMO or REAL
MT5_ACCOUNT_TYPE=DEMO

# Server & Runtime Configuration (Render / Local)
PORT=3000
NODE_ENV=production
# Trading Runtime Mode: 'production' (Render authoritative instance) or 'shadow' (AI Studio / test / dev)
# Default is 'shadow' for non-production environments to prevent duplicate Telegram alerts or state mutations.
TRADING_RUNTIME_MODE=shadow

# Production Scanner Architecture Switch
# Set ENABLE_INTERNAL_SCANNER=false or SCANNER_TRIGGER_MODE=cron in production (Render)
# so the external cron scheduler (/api/scanner/cron-tick) is the sole authoritative trigger.
ENABLE_INTERNAL_SCANNER=false
SCANNER_TRIGGER_MODE=cron

# Telegram Bot Integration (Notifications only - No trade execution)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram Authorized User IDs (comma-separated personal Telegram user IDs authorized to press outcome buttons)
# Example: TELEGRAM_AUTHORIZED_USER_IDS=1189889156
TELEGRAM_AUTHORIZED_USER_IDS=

# Supabase PostgreSQL Durable Storage Configuration
# Required for persisting trades, signals, scans, settings and account balance to Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively: SUPABASE_KEY or SUPABASE_ANON_KEY
SUPABASE_KEY=

